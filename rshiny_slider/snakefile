rule ppv_grid:
    input:
        combined = "results/{set}/ALSFTD_common_{ALSFTD_COMMON}_ALSFTD_rare_{ALSFTD_RARE}_h2als_{H2_ALS}/combined_simulations.csv",
    output:
        als_grid    = "results/{set}/ALSFTD_common_{ALSFTD_COMMON}_ALSFTD_rare_{ALSFTD_RARE}_h2als_{H2_ALS}/output_ppv_als_grid.csv",
        alsftd_grid = "results/{set}/ALSFTD_common_{ALSFTD_COMMON}_ALSFTD_rare_{ALSFTD_RARE}_h2als_{H2_ALS}/output_ppv_alsftd_grid.csv",
    resources:
        mem_mb = 5000,
        runtime = 60
    shell:
        "Rscript src/PPV_grid.R {input.combined} {output.als_grid} {output.alsftd_grid}"

rule combine_ppv_grids:
    input:
        als_grids = expand(
            "results/{set}/ALSFTD_common_{ALSFTD_COMMON}_ALSFTD_rare_{ALSFTD_RARE}_h2als_{H2_ALS}/output_ppv_als_grid.csv",
            set=SETS, ALSFTD_COMMON=ALSFTD_COMMON, ALSFTD_RARE=ALSFTD_RARE, H2_ALS=H2_ALS
        ),
        alsftd_grids = expand(
            "results/{set}/ALSFTD_common_{ALSFTD_COMMON}_ALSFTD_rare_{ALSFTD_RARE}_h2als_{H2_ALS}/output_ppv_alsftd_grid.csv",
            set=SETS, ALSFTD_COMMON=ALSFTD_COMMON, ALSFTD_RARE=ALSFTD_RARE, H2_ALS=H2_ALS
        )
    output:
        als = "varying_param_als_grid.csv",
        alsftd = "varying_param_alsftd_grid.csv"
    resources:
        mem_mb = 10000,
        runtime = 60
    script:
        "src/combine_ppv_grids.R"        