# Snakefile
# command: snakemake -s snakefile --executor slurm --jobs 5000 --default-resources mem_mb=5000 runtime=900 constraint="avx2" --rerun-incomplete --keep-going --latency-wait 90 --cores 1 --slurm-keep-successful-logs all


# Define the number of simulations and how many to run per job
TOTAL_SIMULATIONS = 10000000
SIMULATIONS_PER_JOB = 25000

SETS = ["rshiny_slider"]
ALSFTD_COMMON = ["0.10", "0.20", "0.30", "0.40", "0.50"]
ALSFTD_RARE = ["0.30", "0.40", "0.50", "0.60", "0.70"]
H2_ALS = ["0.20", "0.30", "0.40", "0.50", "0.60"]

CHUNKS = range(0, TOTAL_SIMULATIONS, SIMULATIONS_PER_JOB)

rule all:
    input:
        # expand("results/{set}/ALSFTD_common_{ALSFTD_COMMON}_ALSFTD_rare_{ALSFTD_RARE}_h2als_{H2_ALS}/combined_simulations.csv", 
        #     set=SETS, ALSFTD_COMMON=ALSFTD_COMMON, ALSFTD_RARE=ALSFTD_RARE, H2_ALS=H2_ALS),
        # expand("results/{set}/ALSFTD_common_{ALSFTD_COMMON}_ALSFTD_rare_{ALSFTD_RARE}_h2als_{H2_ALS}/combined_metrics.csv", 
        #     set=SETS, ALSFTD_COMMON=ALSFTD_COMMON, ALSFTD_RARE=ALSFTD_RARE, H2_ALS=H2_ALS),
        # expand("results/{set}/ALSFTD_common_{ALSFTD_COMMON}_ALSFTD_rare_{ALSFTD_RARE}_h2als_{H2_ALS}/prediction_model.csv", 
        #     set=SETS, ALSFTD_COMMON=ALSFTD_COMMON, ALSFTD_RARE=ALSFTD_RARE, H2_ALS=H2_ALS),
        expand("results/{set}/ALSFTD_common_{ALSFTD_COMMON}_ALSFTD_rare_{ALSFTD_RARE}_h2als_{H2_ALS}/output_ppv_als_grid.csv", 
            set=SETS, ALSFTD_COMMON=ALSFTD_COMMON, ALSFTD_RARE=ALSFTD_RARE, H2_ALS=H2_ALS),
        expand("results/{set}/ALSFTD_common_{ALSFTD_COMMON}_ALSFTD_rare_{ALSFTD_RARE}_h2als_{H2_ALS}/output_ppv_alsftd_grid.csv", 
            set=SETS, ALSFTD_COMMON=ALSFTD_COMMON, ALSFTD_RARE=ALSFTD_RARE, H2_ALS=H2_ALS),
        "varying_param_als_grid.csv",
        "varying_param_alsftd_grid.csv"            

