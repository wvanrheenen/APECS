# Snakefile
# command: snakemake -s snakefile --executor slurm --jobs 125 --default-resources mem_mb=5000 runtime=900 constraint="avx2" --rerun-incomplete --keep-going --latency-wait 90 --cores 1 --slurm-keep-successful-logs all

BASELINE_PEDS = 10000  
REPS = range(1, 11)
SETS = ["monogenic", "polygenic", "combined"]
H2 = ["0.3", "0.4", "0.45", "0.5", "0.6"]


def ped_multiplier(set):
    """Pedigree multiplier: 3x for SET=monogenic"""
    multiplier = 1.0
    if set == "monogenic":
        multiplier *= 3.0 
    return multiplier 

rule all:
    input:
        expand("results/heritability_set_{set}_reps{reps}_h2{h2}.tsv", 
               set=SETS, reps=REPS, h2=H2),
        expand("results/{h2}/heritability_separate_summary.tsv", h2=H2)

rule run_heritability_simulation:
    output:
        tsv="results/heritability_set_{set}_reps{reps}_h2{h2}.tsv"
    input:
        rscript="heritability_simulation.R"
    params:
        set="{set}",
        n_peds= lambda wildcards: int(BASELINE_PEDS * ped_multiplier(wildcards.set)),
        rep="{reps}",
        h2="{h2}",
    resources:
        mem_mb=5000,
        runtime=1800
    shell:
        """
        mkdir -p results
        Rscript {input.rscript} {params.set} {params.n_peds} {params.rep} {params.h2} {output.tsv}
        """

rule summarize_decomposition:
    output:
        tsv="results/{h2}/heritability_separate_summary.tsv"
    input:
        tsvs=lambda wildcards: expand("results/heritability_set_{set}_reps{reps}_h2{{h2}}.tsv",
                                      set=SETS, reps=REPS, h2=wildcards.h2)
    script:
        "summarize_heritability.R"