rule plot_metrics_percentage:
    input:
        models = percentage_sweep
    output:
        plots = "results/varying_percentage/metrics_plots_varying_percentage.pdf"
    params:
        output_dir = "results",
        sweep_type = "varying_percentage"
    script:
        "src/plot_metrics.R"