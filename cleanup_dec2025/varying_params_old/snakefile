# Snakefile
# command: snakemake -s snakefile --executor slurm --jobs 500 --default-resources mem_mb=5000 runtime=28800 constraint="avx2" --rerun-incomplete --keep-going --latency-wait 90 --cores 4 --slurm-keep-successful-logs all
# or with slurm profile: snakemake -s snakefile --profile slurm --jobs 500 --rerun-incomplete --keep-going --latency-wait 90 --cores 4 --slurm-keep-successful-logs all 


configfile: "config.yaml"
baseline = config["baseline"]

# Define the number of simulations and how many to run per job
TOTAL_SIMULATIONS = 250000
SIMULATIONS_PER_JOB = 2500


# Define parameter sweeps
fertility_sweep = expand(
    "results/{sweep_type}/frmod_{frmod}_lemod_{lemod}_penalsmod_{penalsmod}_penftdmod_{penftdmod}/{perc}perc/prediction_model_perc.csv",
    sweep_type=["varying_fertility"],
    frmod=config["fertility_rate_modifiers"],
    lemod=[baseline["life_expectancy_modifier"]],
    penalsmod=[baseline["penetrance_ALS_modifier"]],
    penftdmod=[baseline["penetrance_FTD_modifier"]],
    perc=[baseline["mendelian_modifier"]]
)

life_expectancy_sweep = expand(
    "results/{sweep_type}/frmod_{frmod}_lemod_{lemod}_penalsmod_{penalsmod}_penftdmod_{penftdmod}/{perc}perc/prediction_model_perc.csv",
    sweep_type=["varying_life_expectancy"],
    frmod=[baseline["fertility_rate_modifier"]],
    lemod=config["life_expectancy_modifiers"],
    penalsmod=[baseline["penetrance_ALS_modifier"]],
    penftdmod=[baseline["penetrance_FTD_modifier"]],
    perc=[baseline["mendelian_modifier"]]
)

penetrance_als_sweep = expand(
    "results/{sweep_type}/frmod_{frmod}_lemod_{lemod}_penalsmod_{penalsmod}_penftdmod_{penftdmod}/{perc}perc/prediction_model_perc.csv",
    sweep_type=["varying_penetrance_als"],
    frmod=[baseline["fertility_rate_modifier"]],
    lemod=[baseline["life_expectancy_modifier"]],
    penalsmod=config["penetrance_ALS_modifiers"],
    penftdmod=[baseline["penetrance_FTD_modifier"]],
    perc=[baseline["mendelian_modifier"]]
)

penetrance_ftd_sweep = expand(
    "results/{sweep_type}/frmod_{frmod}_lemod_{lemod}_penalsmod_{penalsmod}_penftdmod_{penftdmod}/{perc}perc/prediction_model_perc.csv",
    sweep_type=["varying_penetrance_ftd"],
    frmod=[baseline["fertility_rate_modifier"]],
    lemod=[baseline["life_expectancy_modifier"]],
    penalsmod=[baseline["penetrance_ALS_modifier"]],
    penftdmod=config["penetrance_FTD_modifiers"],
    perc=[baseline["mendelian_modifier"]]
)

# Percentage sweep (vary perc, keep all else at baseline)
percentage_sweep = expand(
    "results/{sweep_type}/frmod_{frmod}_lemod_{lemod}_penalsmod_{penalsmod}_penftdmod_{penftdmod}/{perc}perc/prediction_model_perc.csv",
    sweep_type=["varying_percentage"],
    frmod=[baseline["fertility_rate_modifier"]],
    lemod=[baseline["life_expectancy_modifier"]],
    penalsmod=[baseline["penetrance_ALS_modifier"]],
    penftdmod=[baseline["penetrance_FTD_modifier"]],
    perc=config["mendelian_percentages"]  # All percentages
)

# Combine all target files
rule all:
    input:
        fertility_sweep + life_expectancy_sweep + penetrance_als_sweep + penetrance_ftd_sweep + percentage_sweep,         
        "results/varying_fertility/metrics_plots_varying_fertility.pdf",
        "results/varying_life_expectancy/metrics_plots_varying_life_expectancy.pdf",
        "results/varying_penetrance_als/metrics_plots_varying_penetrance_als.pdf",
        "results/varying_penetrance_ftd/metrics_plots_varying_penetrance_ftd.pdf",
        "results/varying_percentage/metrics_plots_varying_percentage.pdf"


rule install_packages:
    output:
        touch("logs/packages_installed.txt")
    script:
        "src/install_packages.R"

rule run_simulation:
    input:
        packages = "logs/packages_installed.txt"
    output:
        results = "results/{sweep_type}/frmod_{frmod}_lemod_{lemod}_penalsmod_{penalsmod}_penftdmod_{penftdmod}/simulation_{chunk}.csv",
        metrics = "results/{sweep_type}/frmod_{frmod}_lemod_{lemod}_penalsmod_{penalsmod}_penftdmod_{penftdmod}/metrics_{chunk}.csv"
    threads: 4,
    params:
        frmod = lambda wildcards: wildcards.frmod,
        lemod = lambda wildcards: wildcards.lemod,
        penalsmod = lambda wildcards: wildcards.penalsmod,
        penftdmod = lambda wildcards: wildcards.penftdmod,
        sweep_type = lambda wildcards: wildcards.sweep_type
    resources: 
        runtime=lambda wildcards: 86400 if (
            wildcards.sweep_type == "varying_fertility" and int(wildcards.frmod) > 5
        ) else 28800
    shell:
        "Rscript simulation.R {wildcards.chunk} {SIMULATIONS_PER_JOB} {params.frmod} {params.lemod} {params.penalsmod} {params.penftdmod} {params.sweep_type} {output.results} {output.metrics}"

rule combine_results:
    input:
        results = expand(
            "results/{sweep_type}/frmod_{frmod}_lemod_{lemod}_penalsmod_{penalsmod}_penftdmod_{penftdmod}/simulation_{chunk}.csv",
            chunk=range(0, TOTAL_SIMULATIONS, SIMULATIONS_PER_JOB),
            frmod=lambda wildcards: wildcards.frmod,
            lemod=lambda wildcards: wildcards.lemod,
            penalsmod=lambda wildcards: wildcards.penalsmod,
            penftdmod=lambda wildcards: wildcards.penftdmod,
            sweep_type=lambda wildcards: wildcards.sweep_type
        ),
        metrics = expand(
            "results/{sweep_type}/frmod_{frmod}_lemod_{lemod}_penalsmod_{penalsmod}_penftdmod_{penftdmod}/metrics_{chunk}.csv",
            chunk=range(0, TOTAL_SIMULATIONS, SIMULATIONS_PER_JOB),
            frmod=lambda wildcards: wildcards.frmod,
            lemod=lambda wildcards: wildcards.lemod,
            penalsmod=lambda wildcards: wildcards.penalsmod,
            penftdmod=lambda wildcards: wildcards.penftdmod,
            sweep_type=lambda wildcards: wildcards.sweep_type
        )
    output:
        combined_results = "results/{sweep_type}/frmod_{frmod}_lemod_{lemod}_penalsmod_{penalsmod}_penftdmod_{penftdmod}/combined_simulations.csv",
        combined_metrics = "results/{sweep_type}/frmod_{frmod}_lemod_{lemod}_penalsmod_{penalsmod}_penftdmod_{penftdmod}/combined_metrics.csv",
        prediction_model = "results/{sweep_type}/frmod_{frmod}_lemod_{lemod}_penalsmod_{penalsmod}_penftdmod_{penftdmod}/combined_predictionmodel.csv"
    script:
        "src/combine_results.R"

rule filter_mendelian_proportion:
    input:
        combined_results = "results/{sweep_type}/frmod_{frmod}_lemod_{lemod}_penalsmod_{penalsmod}_penftdmod_{penftdmod}/combined_simulations.csv"
    output:
        filtered = "results/{sweep_type}/frmod_{frmod}_lemod_{lemod}_penalsmod_{penalsmod}_penftdmod_{penftdmod}/{perc}perc/simulations_{perc}perc_mend.csv"
    params:
        perc = lambda wildcards: wildcards.perc
    script:
        "src/filter_mendelian_proportion.R"

rule perc_predictions:
    input:
        filtered = "results/{sweep_type}/frmod_{frmod}_lemod_{lemod}_penalsmod_{penalsmod}_penftdmod_{penftdmod}/{perc}perc/simulations_{perc}perc_mend.csv",
    output:
        model = "results/{sweep_type}/frmod_{frmod}_lemod_{lemod}_penalsmod_{penalsmod}_penftdmod_{penftdmod}/{perc}perc/prediction_model_perc.csv"
    script:
        "src/perc_predictions.R"

rule plot_metrics_fertility:
    input:
        models = fertility_sweep
    output:
        plots = "results/varying_fertility/metrics_plots_varying_fertility.pdf"
    params:
        output_dir = "results",
        sweep_type = "varying_fertility"
    script:
        "src/plot_metrics.R"

rule plot_metrics_life_expectancy:
    input:
        models = life_expectancy_sweep
    output:
        plots = "results/varying_life_expectancy/metrics_plots_varying_life_expectancy.pdf"
    params:
        output_dir = "results",
        sweep_type = "varying_life_expectancy"
