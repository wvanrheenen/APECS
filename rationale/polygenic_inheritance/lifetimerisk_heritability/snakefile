# Snakefile
# command: snakemake -s snakefile --executor slurm --jobs 1000 --default-resources mem_mb=5000 runtime=900 constraint="avx2" --rerun-incomplete --keep-going --latency-wait 90 --cores 4 --slurm-keep-successful-logs all

# h2_ALS = ["0.3", "0.7"]
# K_ALS = ["0.3", "0.10"]
# h2_FTD = ["0.3", "0.7"]
# K_FTD= ["0.3", "0.10"]
# rg_ALSFTD = ["0.2", "0.8"]
# LAMBDA = ["2", "3"] 
# GENS = ["2"]
# REPS = range(1,6)  
# BASE_N_PEDS = 500

h2_ALS = ["0.2", "0.5", "0.8"]
K_ALS = ["0.001", "0.005", "0.05"]
h2_FTD = ["0.5"]
K_FTD = ["0.001", "0.005", "0.05"]
rg_ALSFTD = ["0.2", "0.5", "0.8"]
LAMBDA = ["1.5", "2", "3"] 
GENS = ["3"]
REPS = range(1,6)  
BASE_N_PEDS = 10000

def ped_multiplier(k_als, k_ftd, gens):
    """Pedigree multiplier: 3x for K=0.001, 0.1x for 3 gens, else 1x"""
    multiplier = 1.0
    
    # 3x pedigrees for rare diseases (K=0.001)
    if k_als == "0.001":
        multiplier *= 3.0
    
    # 0.1x pedigrees for 3 generations (larger pedigrees)
    if gens == "3":
        multiplier *= 0.1
    
    return multiplier 

rule all:
    input:
        expand("results/poly_h2ALS{h2_ALS}_KALS{K_ALS}_h2FTD{h2_FTD}_KFTD{K_FTD}_rg{rg_ALSFTD}_lam{lam}_gens{gens}_rep{reps}.tsv",
               h2_ALS=h2_ALS, K_ALS=K_ALS, h2_FTD=h2_FTD, K_FTD=K_FTD, 
               rg_ALSFTD=rg_ALSFTD, lam=LAMBDA, gens=GENS, reps=REPS),
        "polygenic_inheritance_all.tsv",       
        expand("plots/h2_ALS/{facet}_validation.pdf", facet=["h2_FTD_input", "K_FTD_input", "rg_ALSFTD_input", "lambda"]),
        expand("plots/K_ALS/{facet}_validation.pdf", facet=["h2_FTD_input", "K_FTD_input", "rg_ALSFTD_input", "lambda"]),
        expand("plots/lambda1/lambda1_theor_by_{param}_{fillvar}.pdf", param=["K_ALS", "h2_ALS"], fillvar=["lambda", "K_FTD_input", "h2_FTD_input", "rg_ALSFTD_input"]),
        expand("plots/rg_ALSFTD/{facet}_validation.pdf", facet=["h2_ALS_input", "K_ALS_input", "h2_FTD_input", "K_FTD_input", "lambda"]),


rule simulate_polygenic:
    output:
        tsv="results/poly_h2ALS{h2_ALS}_KALS{K_ALS}_h2FTD{h2_FTD}_KFTD{K_FTD}_rg{rg_ALSFTD}_lam{lam}_gens{gens}_rep{reps}.tsv"
    input:
        rscript = "polygenic_inheritance.R"
    params:
        h2_ALS="{h2_ALS}",
        K_ALS="{K_ALS}",
        h2_FTD="{h2_FTD}",
        K_FTD="{K_FTD}",
        rg_ALSFTD="{rg_ALSFTD}",
        lam="{lam}",
        gens="{gens}",
        # Dynamic N_PEDS with full multiplier logic
        peds=lambda wildcards: int(BASE_N_PEDS * ped_multiplier(wildcards.K_ALS, wildcards.K_FTD, wildcards.gens)),
        singlerep=1,
        reps="{reps}",
    resources:
        mem_mb=lambda wildcards: 5000 if (wildcards.K_ALS == "0.001") else 5000 if wildcards.lam == "3" else 2000,
        runtime=1200 if "{gens}" == "3" else 900
    shell:
        """
        mkdir -p results
        Rscript {input.rscript} {params.h2_ALS} {params.K_ALS} {params.h2_FTD} {params.K_FTD} {params.rg_ALSFTD} {params.lam} {params.gens} {params.peds} {params.singlerep} {params.reps} {output.tsv}
        """


rule combine_simulations:
    input:
        expand("results/poly_h2ALS{h2_ALS}_KALS{K_ALS}_h2FTD{h2_FTD}_KFTD{K_FTD}_rg{rg_ALSFTD}_lam{lam}_gens{gens}_rep{reps}.tsv",
               h2_ALS=h2_ALS, K_ALS=K_ALS, h2_FTD=h2_FTD, K_FTD=K_FTD, 
               rg_ALSFTD=rg_ALSFTD, lam=LAMBDA, gens=GENS, reps=REPS)
    output:
        combined="polygenic_inheritance_all.tsv"
    shell:
        """
        mkdir -p results
        head -n 1 {input[0]} > {output.combined}  # Copy header from first file
        tail -n +2 -q {input} >> {output.combined}  # Append data rows from all files
        echo "Combined $(wc -l < {output.combined}) rows from $(echo {input} | wc -w) files"
        """

rule plot_h2_ALS_all:
    input: "polygenic_inheritance_all.tsv"
    output: expand("plots/h2_ALS/{facet}_validation.pdf", facet=["h2_FTD_input", "K_FTD_input", "rg_ALSFTD_input", "lambda"])
    shell:
        """
        mkdir -p plots/h2_ALS
        Rscript polygenic_plot.R --type h2_ALS --input {input} --facets h2_FTD_input K_FTD_input rg_ALSFTD_input lambda --plotdir plots
        """

